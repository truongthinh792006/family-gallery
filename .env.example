# Mật khẩu quản trị & cài đặt (Admin Panel)
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# Mật khẩu xem album (tùy chọn)
NEXT_PUBLIC_FAMILY_PASSWORD=giadinh2024

# Cấu hình Vercel KV (Lấy từ Vercel Dashboard > Storage > KV)
# Khi deploy lên Vercel, các biến này sẽ được Vercel tự động điền
KV_URL=redis://default:xxx@xxx.upstash.io:6379
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=xxx
KV_REST_API_READ_ONLY_TOKEN=xxx
